# Runtime (optional). Empty = browser calls same-origin /api
VITE_API_BASE_URL=

# Production VPS builds set VITE_USE_PLATFORM_API=1 (see scripts/deploy-to-vps.sh)
# VITE_USE_PLATFORM_API=0

# For shipping to the inventivelab VPS (isolated stack):
#   VPS_HOST / VPS_USER / VPS_PASSWORD in local .env (gitignored)
#   npm run deploy:vps
#
# DB credentials stay on the server in /opt/onetrack-platform/.env — never in VITE_*.

