# --- Local UI talks to the LIVE platform API (same data as production) ---
# Leave VITE_API_BASE_URL empty so the Vite proxy forwards /api → production.
VITE_USE_PLATFORM_API=1
VITE_API_BASE_URL=

# Optional: override the proxy target (default: https://api.onetrack.inventivelab.bd)
# VITE_DEV_API_PROXY=https://api.onetrack.inventivelab.bd

# Demo/offline seed logins only if you explicitly want them (not live data):
# VITE_ALLOW_OFFLINE_AUTH=1
# VITE_USE_PLATFORM_API=0

# For shipping UI + API to the inventivelab VPS (isolated stack):
#   VPS_HOST / VPS_USER / VPS_PASSWORD in local .env (gitignored)
#   npm run deploy:vps
#
# DB credentials stay on the server in /opt/onetrack-platform/.env — never in VITE_*.

# --- Platform API auth (server .env on VPS; also usable locally under server/) ---
# PLATFORM_ADMIN_EMAIL=aminulislamborhan@gmail.com
# PLATFORM_ADMIN_PASSWORD=change-me-strong
# SEED_AGENCY_PASSWORD=change-me-strong
# SEED_FORCE_PASSWORDS=0   # set 1 only when changing seed passwords, then set back to 0
# UPLOAD_DIR=/data/uploads

# --- Password-reset email (SMTP via inventivelab cPanel mail) ---
# PLATFORM_PUBLIC_UI_URL=https://onetrack.inventivelab.bd
# SMTP_HOST=mail.inventivelab.bd
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=noreply@inventivelab.bd
# SMTP_PASSWORD=change-me-strong
# SMTP_FROM=OneTrack <noreply@inventivelab.bd>

# --- SMSQ outbound SendSMS (product is send-only for now) ---
# Docs: https://api.smsq.global/swagger/index.html
# SMSQ_API_KEY=
# SMSQ_CLIENT_ID=
# SMSQ_SENDER_ID=8809617602051
# Optional legacy inbound webhook (unused in UI):
# SMSQ_WEBHOOK_SECRET=
# SMSQ_DEFAULT_TENANT_ID=tenant-full

# --- Subscription billing (server .env on VPS) ---
# Paymently / UddoktaPay hosted checkout (recommended for subscription fees):
# BILLING_GATEWAY=uddoktapay
# UDDOKTAPAY_API_URL=https://onetrack.paymently.io/api
# UDDOKTAPAY_API_KEY=
# PLATFORM_PUBLIC_UI_URL=https://onetrack.inventivelab.bd
# PLATFORM_PUBLIC_API_URL=https://onetrack.inventivelab.bd
# (webhook + return URLs are derived from PLATFORM_PUBLIC_API_URL)
#
# Manual fallback (admin verifies Txn ID):
# BILLING_GATEWAY=manual
# BILLING_WEBHOOK_SECRET=
# BILLING_GATEWAY_CHECKOUT_URL=
# BILLING_BKASH_NUMBER=
# BILLING_NAGAD_NUMBER=
# BILLING_BANK_NAME=
# BILLING_BANK_ACCOUNT=
# BILLING_BANK_ROUTING=
# BILLING_SUPPORT_EMAIL=support@inventivelab.bd
# BILLING_PAY_NOTE=Pay the invoice amount, then submit your transaction ID for verification.
